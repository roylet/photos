<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark mode: the window (and the launch splash) start on the dark paper, so there's no white flash. -->
    <style name="Theme.Photos" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
